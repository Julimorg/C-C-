  COMMAND = cmd.exe /C "cd /D "F:\Programming\File programming\Cpp and C++\cmake-build-debug" && F:\CLion\bin\cmake\win\x64\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util



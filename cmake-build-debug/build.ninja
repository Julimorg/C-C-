build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D "F:\Programming\File programming\Cpp and C++\cmake-build-debug" && F:\CLion\bin\cmake\win\x64\bin\cmake.exe --regenerate-during-build -S"F:\Programming\File programming\Cpp and C++" -B"F:\Programming\File programming\Cpp and C++\cmake-build-debug""
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

